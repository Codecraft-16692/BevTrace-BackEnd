@startuml iam-database-diagram
title BevTrace - iam tables (generated)
hide circle
skinparam linetype ortho

entity roles {
  *id : bigint
   created_at : timestamp
   updated_at : timestamp
   name : String
   is_admin : boolean
}
entity users {
  *id : bigint
   created_at : timestamp
   updated_at : timestamp
   role_id : Long <<FK>>
   name : String
   email : String
   password_hash : String
   phone : String
   active : boolean
}
@enduml
